---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getImage } from 'astro:assets';
import { menuPages as sourcePages, formatPrice } from '../data/menu';

const menuPages = await Promise.all(sourcePages.map(async (page) => {
  const widths = [320, 480, 640, 960];
  const thumbnails = await Promise.all(widths.map(width => getImage({ src: page.image, width, format: 'webp', quality: 85 })));
  const reading = await getImage({ src: page.image, format: 'webp', quality: 92 });
  return { ...page, thumbnail: thumbnails[1].src, srcset: thumbnails.map((image, index) => image.src + ' ' + widths[index] + 'w').join(', '), reading: reading.src };
}));
---

<BaseLayout>
  <a class="skip-link" href="#contenido">Saltar al contenido</a>
  <header class="site-header">
    <a class="brand" href="#carta" aria-label="Bar Plaza, ir al inicio">
      <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 36 44" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M3 4h18c7 0 11 4 11 10s-4 10-11 10h-6v12h5v3H3v-3h5V7H3V4zm12 3v14h5c5 0 6-3 6-7s-1-7-6-7h-5z" /></svg></span>
      <span class="brand__name">BAR <strong>PLAZA</strong></span>
    </a>
    <nav class="main-nav" aria-label="Navegación principal">
      <a href="#carta">La carta</a>
      <a href="#contacto">Ven a vernos</a>
    </nav>
    <div class="header-phone">
      <span>Llámanos</span>
      <span class="header-phone__number">91 941 46 66</span>
    </div>
  </header>

  <main id="contenido">
    <section class="menu-section section-pad" id="carta" aria-labelledby="menu-title">
      <div class="section-heading">
        <div>
          <h1 id="menu-title">La carta<span class="sr-only"> de Bar Plaza en Pinto</span><span class="period" aria-hidden="true">.</span></h1>
        </div>
        <p>Un vistazo a nuestra carta. Toca cualquier página para ampliarla y consultar los platos y precios.</p>
      </div>

      <div class="menu-grid">
        {menuPages.map((page, index) => (
          <a
            class="menu-card"
            href={page.reading}
            data-menu-id={page.id}
            data-menu-image={page.reading}
            data-menu-title={page.title}
            aria-label={`Ampliar carta: ${page.title}`}
          >
            <span class="menu-card__image-wrap">
              <img src={page.thumbnail} srcset={page.srcset} sizes="(max-width: 680px) 86vw, (max-width: 1280px) 40vw, 480px" width={page.image.width} height={page.image.height} alt={page.alt} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} decoding="async" />
              <span class="menu-card__zoom" aria-hidden="true">↗</span>
            </span>
            <span class="menu-card__body">
              <strong>{page.title}</strong>
              <span class="menu-card__arrow" aria-hidden="true">↗</span>
            </span>
          </a>
        ))}
      </div>

      <div class="menu-transcription">
        <h2>Consultar la carta en texto</h2>
        {menuPages.map((page) => (
          <details id={`texto-${page.id}`}>
            <summary>{page.title}</summary>
            {page.groups.map(group => (
              <div class="menu-text-group">
                <h3>{group.title}</h3>
                {group.items.some(item => item.montadoPrice !== undefined) ? (
                  <table>
                    <caption class="sr-only">Precios de {group.title.toLowerCase()}</caption>
                    <thead><tr><th scope="col">Bocadillo</th><th scope="col">Precio</th><th scope="col">Montado</th></tr></thead>
                    <tbody>{group.items.map(item => <tr><th scope="row">{item.name}</th><td>{formatPrice(item.price)}</td><td>{item.montadoPrice !== undefined ? formatPrice(item.montadoPrice) : '—'}</td></tr>)}</tbody>
                  </table>
                ) : (
                  <ul>{group.items.map(item => (
                    <li><span><strong>{item.name}</strong>{item.description && <span class="menu-item-description">{item.description}</span>}</span><span class="menu-item-price">{formatPrice(item.price)}</span></li>
                  ))}</ul>
                )}
              </div>
            ))}
          </details>
        ))}
        <p>Suplemento de terraza: +8 %. Consulta los alérgenos en el establecimiento.</p>
      </div>

      <div class="allergen-note"><span aria-hidden="true">✳</span><p>Si tienes alguna alergia o intolerancia, consúltanos antes de pedir. La información completa de alérgenos aparece en la carta del establecimiento.</p></div>
    </section>

    <section class="contact-section section-pad" id="contacto" aria-labelledby="contact-title">
      <div class="contact-section__heading">
        <p class="eyebrow"><span class="eyebrow__line"></span> NOS ENCONTRAMOS AQUÍ</p>
        <h2 id="contact-title">Ven a vernos<span class="period">.</span></h2>
      </div>
      <div class="contact-grid">
        <div class="contact-card contact-card--address">
          <span class="contact-card__number">01 / DIRECCIÓN</span>
          <h3>Bar Plaza</h3>
          <p>Calle Joan Miró, 5<br />28320 Pinto, Madrid</p>
          <a class="text-link" href="https://www.google.com/maps/place//data=!4m2!3m1!1s0xd421f7746265553:0x62a183287a7c8f9e" target="_blank" rel="noopener noreferrer">Ver en Google Maps <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
        </div>
        <div class="contact-card">
          <span class="contact-card__number">02 / TELÉFONO</span>
          <h3>¿Hablamos?</h3>
          <p>Estamos al otro lado<br />del teléfono.</p>
          <span class="contact-phone">91 941 46 66</span>
        </div>
        <div class="contact-card contact-card--delivery">
          <span class="contact-card__number">03 / A DOMICILIO</span>
          <h3>Plaza en tu casa</h3>
          <p>Elige tus platos y haz tu pedido<br />a través de Uber Eats.</p>
          <a class="button button--dark delivery-link" href="https://www.ubereats.com/es/store/restaurante-plaza/tNRVogSYU0afIAvwNRZTxA" target="_blank" rel="noopener noreferrer"><img class="delivery-logo" src="/uber-eats.svg" alt="" width="32" height="32" />Pedir en Uber Eats <span aria-hidden="true">↗</span><span class="sr-only"> (se abre en una pestaña nueva)</span></a>
        </div>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <a class="brand brand--footer" href="#carta" aria-label="Bar Plaza, ir al inicio">
      <span class="brand__mark" aria-hidden="true"><svg viewBox="0 0 36 44" focusable="false"><path fill="currentColor" fill-rule="evenodd" d="M3 4h18c7 0 11 4 11 10s-4 10-11 10h-6v12h5v3H3v-3h5V7H3V4zm12 3v14h5c5 0 6-3 6-7s-1-7-6-7h-5z" /></svg></span>
      <span class="brand__name">BAR <strong>PLAZA</strong></span>
    </a>
    <p>Un bar de barrio en Pinto, Comunidad de Madrid.</p>
    <a href="#carta" class="back-top">Volver arriba ↑</a>
    <small>© {new Date().getFullYear()} Bar Plaza · Pinto</small>
  </footer>

  <dialog class="menu-dialog" aria-labelledby="dialog-title">
    <div class="menu-dialog__bar">
      <p class="menu-dialog__title" id="dialog-title">Carta <span aria-hidden="true">/</span> <span data-dialog-heading></span></p>
      <button class="menu-dialog__close" type="button" aria-label="Cerrar carta ampliada">Cerrar <span aria-hidden="true">×</span></button>
    </div>
    <div class="menu-dialog__tools" role="group" aria-label="Controles de ampliación">
      <button type="button" data-zoom-out aria-label="Reducir carta">−</button>
      <output data-zoom-level aria-live="polite">100 %</output>
      <button type="button" data-zoom-in aria-label="Ampliar carta">+</button>
      <button type="button" data-zoom-reset>Restaurar</button>
    </div>
    <div class="menu-dialog__image-wrap" tabindex="0" role="region" aria-label="Imagen ampliada de la carta" aria-busy="false"><p data-image-status role="status" aria-live="polite"></p><img data-dialog-image alt="" hidden /></div>
    <a class="menu-dialog__fallback" data-image-fallback href="#texto-raciones">Consultar esta carta en texto</a>
    <p class="menu-dialog__hint">Usa + y − para ampliar o reducir. Desplázate por la carta ampliada. Pulsa Escape para cerrar.</p>
  </dialog>
  <script>
    import '../scripts/menu';
  </script>
</BaseLayout>
